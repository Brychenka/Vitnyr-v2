<?xml version="1.0" encoding="UTF-8"?>
<!-- P3 (Stage 6, 2026-09-06): one page, so one <url> — the two languages
     are alternates of it, not separate pages, matching how theme.js and
     index.html's hreflang tags already treat them. https://vitnyrcoach.com/
     is the same RFC 2606 placeholder used across index.html/robots.txt;
     swap it for the real domain in all three places together. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <url>
    <loc>https://vitnyrcoach.com/</loc>
    <xhtml:link rel="alternate" hreflang="en" href="https://vitnyrcoach.com/"/>
    <xhtml:link rel="alternate" hreflang="ru" href="https://vitnyrcoach.com/?lang=ru"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://vitnyrcoach.com/"/>
  </url>
  <!-- 2026-09-23: the Russian URL is its own canonical now (theme.js), so
       it gets its own entry carrying the same alternate set. -->
  <url>
    <loc>https://vitnyrcoach.com/?lang=ru</loc>
    <xhtml:link rel="alternate" hreflang="en" href="https://vitnyrcoach.com/"/>
    <xhtml:link rel="alternate" hreflang="ru" href="https://vitnyrcoach.com/?lang=ru"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://vitnyrcoach.com/"/>
  </url>
</urlset>
